#!/usr/bin/env bash
# Lints staged Swift files with SwiftLint using the repository's .swiftlint.yml.
# Enable with: git config core.hooksPath .githooks
set -euo pipefail

if ! command -v swiftlint >/dev/null 2>&1; then
  echo "error: SwiftLint is not installed. Install it with 'brew install swiftlint'." >&2
  exit 1
fi

cd "$(git rev-parse --show-toplevel)"

files=()
while IFS= read -r -d '' file; do
  files+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACM -z -- '*.swift')

[ "${#files[@]}" -eq 0 ] && exit 0

# --force-exclude makes SwiftLint honor `excluded:` for explicitly passed files.
swiftlint lint --strict --quiet --force-exclude "${files[@]}"
